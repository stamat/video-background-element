{
  "name": "video-background-element",
  "version": "1.2.0",
  "description": "<video-background>: a video background from a YouTube, Vimeo or video file link, as a custom element.",
  "main": "dist/video-background.js",
  "exports": {
    ".": {
      "import": "./src/video-background.mjs",
      "default": "./dist/video-background.js"
    },
    "./controls": {
      "import": "./src/controls.mjs",
      "default": "./dist/video-background-controls.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./*": "./*",
    "./controls.css": "./dist/video-background-controls.css"
  },
  "customElements": "dist/custom-elements.json",
  "files": [
    "CHANGELOG.md",
    "dist",
    "src",
    "!src/__tests__",
    "!src/styles"
  ],
  "homepage": "https://github.com/stamat/video-background-element",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamat/video-background-element.git"
  },
  "keywords": [
    "video-background",
    "background-video",
    "video",
    "youtube",
    "vimeo",
    "background",
    "hero",
    "embed",
    "autoplay",
    "html5-video",
    "custom-element",
    "web-component"
  ],
  "author": "Nikola Stamatovic <@stamat>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stamat/video-background-element/issues"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "code-preview-element": "^3.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "poops": "^3.0.0",
    "poops-docs-theme": "^5.1.1"
  },
  "scripts": {
    "dev": "poops",
    "manifest": "cem analyze --globs src/video-background.mjs src/controls.mjs --outdir dist --quiet",
    "build": "npm run manifest && poops -b",
    "test": "NODE_OPTIONS='--experimental-vm-modules' npx jest",
    "lint": "npx eslint ."
  },
  "dependencies": {
    "book-of-spells": "^2.8.0"
  }
}
